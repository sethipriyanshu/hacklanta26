# Trust Me Bro — copy to .env. Never commit .env.
DEMO_MODE=true                 # true = replay fixtures only, zero outbound calls
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=anthropic         # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_DAILY_TOKEN_CAP=200000     # hard stop; wrapper refuses calls past this
POLL_INTERVAL_SECONDS=45
NEXT_PUBLIC_API_URL=http://localhost:8000
