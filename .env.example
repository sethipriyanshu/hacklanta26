# Trust Me Bro — copy to .env. Never commit .env.
DEMO_MODE=true                 # true = data from fixtures, zero outbound data calls
REDIS_URL=redis://localhost:6379/0

# LLM provider: anthropic | gemini | azure
LLM_PROVIDER=azure
LLM_MODEL=                      # empty = provider default (claude-opus-5-5 / gemini-2.5-flash)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI (Foundry). Deployment is pinned to the cheap model.
AZURE_OPENAI_ENDPOINT=         # e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# Spend guards
SESSION_COST_CAP_USD=5         # hard per-session dollar ceiling on live LLM calls; wrapper refuses past it
LLM_DAILY_TOKEN_CAP=200000     # secondary daily token ceiling
POLL_INTERVAL_SECONDS=45
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tiger Data (TimescaleDB). Optional: with it set, every market and price change is stored there.
TIGER_DATABASE_URL=
